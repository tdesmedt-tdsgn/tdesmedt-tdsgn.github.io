---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  withDescriptions?: boolean;
}
const { posts, withDescriptions = true } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
      <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
      {withDescriptions && <p>{post.data.description}</p>}
      {post.data.tags.length > 0 && (
        <div class="tag-row">
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </li>
  ))}
</ul>
